page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.container {
  padding: 20rpx;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-1 {
  flex: 1;
}

.price {
  color: #ff6b35;
  font-weight: bold;
}

.price::before {
  content: '¥';
  font-size: 0.8em;
}

.original-price {
  color: #999;
  text-decoration: line-through;
  font-size: 0.8em;
  margin-left: 10rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #ff6b35, #ff8f5e);
  color: #fff;
  border: none;
  border-radius: 44rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-primary::after {
  border: none;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  padding: 20rpx 0;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
}

.tag-hot {
  background: #fff1ec;
  color: #ff6b35;
}

.tag-new {
  background: #e8f5e9;
  color: #4caf50;
}

.tag-seckill {
  background: #fce4ec;
  color: #e91e63;
}

.tag-group {
  background: #e3f2fd;
  color: #2196f3;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
}

.empty-state .empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 30rpx 0;
}
