.page-group { min-height: 100vh; background: #f5f5f5; }
.group-header { background: linear-gradient(135deg, #2196f3, #42a5f5); padding: 40rpx 30rpx; color: #fff; }
.header-title { font-size: 40rpx; font-weight: bold; display: block; margin-bottom: 8rpx; }
.header-desc { font-size: 26rpx; opacity: 0.8; }
.group-list { padding: 20rpx 30rpx; }
.group-card { padding: 24rpx; margin-bottom: 20rpx; }
.group-title { font-size: 30rpx; font-weight: bold; line-height: 42rpx; margin-bottom: 12rpx; display: block; }
.group-price-row { display: flex; align-items: center; margin-bottom: 8rpx; }
.group-price { color: #ff6b35; font-size: 36rpx; font-weight: bold; margin-right: 12rpx; }
.group-joined { font-size: 24rpx; color: #999; margin-bottom: 12rpx; display: block; }
.group-action { display: flex; align-items: center; justify-content: space-between; }
.group-time { font-size: 24rpx; color: #999; }
.group-btn { padding: 12rpx 32rpx; font-size: 26rpx; }
