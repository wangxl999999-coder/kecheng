.page-home {
  padding-bottom: 20rpx;
}

.search-bar {
  padding: 20rpx 30rpx;
  background: #fff;
}

.search-input {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.search-placeholder {
  color: #999;
  font-size: 28rpx;
}

.banner-swiper {
  width: 100%;
  height: 340rpx;
  margin: 20rpx 0;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.category-nav {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 20rpx;
  background: #fff;
  margin: 0 30rpx 20rpx;
  border-radius: 16rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.category-icon {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: #f8f9fa;
  border-radius: 50%;
  margin-bottom: 12rpx;
}

.category-name {
  font-size: 24rpx;
  color: #333;
}

.section {
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.section-header {
  margin-bottom: 10rpx;
}

.section-more {
  font-size: 26rpx;
  color: #999;
}

.course-scroll {
  white-space: nowrap;
  width: 100%;
}

.course-scroll-item {
  display: inline-block;
  width: 300rpx;
  margin-right: 20rpx;
  vertical-align: top;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.course-cover {
  width: 300rpx;
  height: 180rpx;
}

.course-info {
  padding: 16rpx;
}

.course-title {
  font-size: 26rpx;
  color: #333;
  height: 72rpx;
  line-height: 36rpx;
  white-space: normal;
}

.course-meta {
  margin-top: 8rpx;
}

.course-buy {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.seckill-list .seckill-item {
  display: flex;
  flex-direction: row;
  padding: 20rpx;
}

.seckill-cover {
  width: 180rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.seckill-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.seckill-title {
  font-size: 28rpx;
  font-weight: bold;
}

.seckill-price-row {
  display: flex;
  align-items: center;
}

.seckill-price {
  color: #ff6b35;
  font-weight: bold;
  font-size: 32rpx;
  margin-right: 10rpx;
}

.seckill-progress {
  display: flex;
  align-items: center;
}

.seckill-progress progress {
  flex: 1;
  margin-right: 12rpx;
}

.seckill-sold {
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
}

.group-list .group-item {
  padding: 24rpx;
}

.group-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.group-price-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.group-price {
  color: #ff6b35;
  font-weight: bold;
  font-size: 32rpx;
  margin-right: 10rpx;
}

.group-joined {
  font-size: 24rpx;
  color: #999;
}
