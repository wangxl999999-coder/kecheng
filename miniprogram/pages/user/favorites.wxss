.page-favorites { min-height: 100vh; background: #f5f5f5; padding: 20rpx 30rpx; }
.course-card { display: flex; padding: 20rpx; margin-bottom: 20rpx; align-items: center; }
.course-cover { width: 200rpx; height: 140rpx; border-radius: 12rpx; margin-right: 20rpx; flex-shrink: 0; }
.course-info { flex: 1; }
.course-title { font-size: 28rpx; font-weight: bold; line-height: 40rpx; margin-bottom: 8rpx; }
.course-teacher { font-size: 24rpx; color: #999; margin-bottom: 8rpx; }
.cancel-fav { font-size: 24rpx; color: #ff6b35; padding: 12rpx 16rpx; border: 1rpx solid #ff6b35; border-radius: 20rpx; }
.login-btn { margin-top: 30rpx; width: 300rpx; }
