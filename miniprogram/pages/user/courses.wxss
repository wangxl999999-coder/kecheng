.page-courses { min-height: 100vh; background: #f5f5f5; }
.tabs-bar { background: #fff; position: sticky; top: 0; z-index: 100; }
.tabs-inner { display: flex; padding: 0 20rpx; }
.tab-item { padding: 24rpx 28rpx; font-size: 28rpx; color: #666; position: relative; }
.tab-item.active { color: #ff6b35; font-weight: bold; }
.tab-item.active::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 40rpx; height: 6rpx; background: #ff6b35; border-radius: 3rpx; }
.course-list { padding: 20rpx 30rpx; }
.course-card { display: flex; padding: 20rpx; margin-bottom: 20rpx; }
.course-cover { width: 200rpx; height: 140rpx; border-radius: 12rpx; margin-right: 20rpx; flex-shrink: 0; }
.course-info { flex: 1; }
.course-title { font-size: 28rpx; font-weight: bold; line-height: 40rpx; margin-bottom: 12rpx; }
.progress-row { display: flex; align-items: center; margin-bottom: 8rpx; }
.progress-row progress { flex: 1; margin-right: 12rpx; }
.progress-text { font-size: 24rpx; color: #ff6b35; }
.course-meta { font-size: 24rpx; color: #999; }
.login-btn { margin-top: 30rpx; width: 300rpx; }
