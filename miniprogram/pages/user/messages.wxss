.page-messages { min-height: 100vh; background: #f5f5f5; padding: 20rpx 30rpx; }
.msg-card { padding: 24rpx; margin-bottom: 20rpx; }
.msg-card.unread { background: #fff8f5; }
.msg-header { display: flex; align-items: center; margin-bottom: 12rpx; position: relative; }
.msg-icon { font-size: 32rpx; margin-right: 12rpx; }
.msg-title { font-size: 28rpx; font-weight: bold; flex: 1; }
.msg-dot { width: 16rpx; height: 16rpx; background: #ff6b35; border-radius: 50%; margin-left: 12rpx; }
.msg-content { font-size: 26rpx; color: #666; line-height: 40rpx; margin-bottom: 12rpx; display: block; }
.msg-time { font-size: 22rpx; color: #999; }
.login-btn { margin-top: 30rpx; width: 300rpx; }
