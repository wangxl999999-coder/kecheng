.page-notes { min-height: 100vh; background: #f5f5f5; padding: 20rpx 30rpx; }
.note-card { padding: 24rpx; margin-bottom: 20rpx; }
.note-course { font-size: 26rpx; color: #ff6b35; margin-bottom: 12rpx; display: block; }
.note-highlight { background: #fff9c4; padding: 12rpx 16rpx; border-radius: 8rpx; font-size: 26rpx; margin-bottom: 12rpx; border-left: 4rpx solid #ffc107; }
.note-content { font-size: 28rpx; color: #333; line-height: 42rpx; display: block; margin-bottom: 12rpx; }
.note-time { font-size: 22rpx; color: #999; }
.empty-desc { font-size: 24rpx; color: #999; margin-top: 12rpx; }
.login-btn { margin-top: 30rpx; width: 300rpx; }
