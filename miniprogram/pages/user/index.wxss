.page-user { min-height: 100vh; background: #f5f5f5; }
.user-header { background: linear-gradient(135deg, #ff6b35, #ff8f5e); padding: 60rpx 30rpx; display: flex; align-items: center; color: #fff; }
.user-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; border: 4rpx solid rgba(255, 255, 255, 0.3); margin-right: 24rpx; }
.user-info { flex: 1; }
.user-name { font-size: 34rpx; font-weight: bold; display: block; margin-bottom: 8rpx; }
.user-phone { font-size: 26rpx; opacity: 0.8; }
.login-prompt { display: flex; flex-direction: column; align-items: center; width: 100%; }
.login-icon { font-size: 80rpx; margin-bottom: 12rpx; }
.login-text { font-size: 30rpx; }
.stats-bar { display: flex; background: #fff; margin: -30rpx 30rpx 20rpx; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1); }
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 36rpx; font-weight: bold; color: #ff6b35; display: block; }
.stat-label { font-size: 24rpx; color: #666; margin-top: 4rpx; display: block; }
.menu-list { padding: 20rpx 30rpx; }
.menu-section { background: #fff; border-radius: 16rpx; overflow: hidden; }
.menu-item { display: flex; align-items: center; padding: 28rpx 24rpx; border-bottom: 1rpx solid #f0f0f0; position: relative; }
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 36rpx; margin-right: 20rpx; }
.menu-name { flex: 1; font-size: 28rpx; }
.menu-badge { position: absolute; right: 60rpx; background: #e91e63; color: #fff; font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 20rpx; min-width: 30rpx; text-align: center; }
.menu-arrow { font-size: 36rpx; color: #ccc; }
.login-btn { margin-top: 30rpx; width: 300rpx; }
