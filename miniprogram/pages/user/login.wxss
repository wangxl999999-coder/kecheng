.page-login { min-height: 100vh; background: #fff; padding: 60rpx 60rpx; }
.login-header { text-align: center; margin-bottom: 80rpx; padding-top: 60rpx; }
.login-logo { font-size: 100rpx; display: block; margin-bottom: 20rpx; }
.login-title { font-size: 48rpx; font-weight: bold; color: #333; display: block; margin-bottom: 12rpx; }
.login-subtitle { font-size: 26rpx; color: #999; }
.login-form { margin-bottom: 60rpx; }
.form-item { margin-bottom: 40rpx; position: relative; }
.form-label { font-size: 28rpx; color: #666; display: block; margin-bottom: 16rpx; }
.form-input { border: 1rpx solid #e0e0e0; border-radius: 12rpx; padding: 24rpx; font-size: 30rpx; width: 100%; box-sizing: border-box; }
.form-input.code-input { padding-right: 180rpx; }
.code-btn { position: absolute; right: 12rpx; top: 60rpx; background: transparent; color: #ff6b35; font-size: 26rpx; padding: 12rpx 20rpx; border: 1rpx solid #ff6b35; border-radius: 30rpx; }
.code-btn::after { border: none; }
.code-btn.disabled { color: #ccc; border-color: #ccc; }
.login-btn { width: 100%; padding: 24rpx; font-size: 32rpx; margin-top: 20rpx; }
.agreement { text-align: center; margin-top: 30rpx; font-size: 24rpx; color: #999; }
.agreement-link { color: #ff6b35; }
.login-tips { background: #fff8f5; border: 1rpx solid #ffd7c4; border-radius: 12rpx; padding: 24rpx; }
.tips-title { font-size: 26rpx; color: #ff6b35; font-weight: bold; display: block; margin-bottom: 12rpx; }
.tips-content { font-size: 24rpx; color: #999; display: block; line-height: 1.6; }
