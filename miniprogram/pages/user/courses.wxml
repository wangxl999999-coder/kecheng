<view class="page-courses">
  <view class="tabs-bar">
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}">
      <view class="tabs-inner">
        <view class="tab-item {{currentTab === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="name" bindtap="onTabChange" data-index="{{index}}">
          <text>{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="course-list" wx:if="{{courses.length > 0}}">
    <view class="course-card card" wx:for="{{courses}}" wx:key="id" bindtap="onCourseTap" data-id="{{item.courseId}}">
      <image class="course-cover" src="{{item.course.cover}}" mode="aspectFill" />
      <view class="course-info">
        <text class="course-title text-ellipsis-2">{{item.course.title}}</text>
        <view class="progress-row">
          <progress percent="{{item.progress}}" stroke-width="6" activeColor="#ff6b35" backgroundColor="#f0f0f0" />
          <text class="progress-text">{{item.progress}}%</text>
        </view>
        <text class="course-meta">已学{{item.learnedLessons.length}}课时</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{courses.length === 0 && !loading && isLoggedIn}}">
    <text class="empty-icon">📚</text>
    <text>暂无已购课程</text>
  </view>

  <view class="empty-state" wx:if="{{!isLoggedIn}}">
    <text class="empty-icon">🔒</text>
    <text>登录后查看已购课程</text>
    <button class="btn-primary login-btn" bindtap="onLoginTap">立即登录</button>
  </view>
</view>
