<view class="page-messages">
  <view class="msg-list" wx:if="{{messages.length > 0}}">
    <view class="msg-card card {{!item.isRead ? 'unread' : ''}}" wx:for="{{messages}}" wx:key="id" bindtap="onMessageTap" data-id="{{item.id}}">
      <view class="msg-header">
        <text class="msg-icon">{{item.type === 'system' ? '📢' : item.type === 'order' ? '📦' : '🎫'}}</text>
        <text class="msg-title">{{item.title}}</text>
        <view class="msg-dot" wx:if="{{!item.isRead}}"></view>
      </view>
      <text class="msg-content">{{item.content}}</text>
      <text class="msg-time">{{item.createdAt}}</text>
    </view>
  </view>
  <view class="empty-state" wx:if="{{messages.length === 0 && !loading && isLoggedIn}}">
    <text class="empty-icon">🔔</text>
    <text>暂无消息</text>
  </view>
  <view class="empty-state" wx:if="{{!isLoggedIn}}">
    <text class="empty-icon">🔒</text>
    <text>登录后查看消息</text>
    <button class="btn-primary login-btn" bindtap="onLoginTap">立即登录</button>
  </view>
</view>
