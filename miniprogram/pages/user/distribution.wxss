.page-distribution { min-height: 100vh; background: #f5f5f5; }
.dist-header { background: linear-gradient(135deg, #9c27b0, #ba68c8); padding: 40rpx 30rpx; color: #fff; }
.dist-title { font-size: 40rpx; font-weight: bold; display: block; margin-bottom: 8rpx; }
.dist-desc { font-size: 26rpx; opacity: 0.8; }
.stats-bar { display: flex; background: #fff; margin: -30rpx 30rpx 20rpx; border-radius: 16rpx; padding: 30rpx; box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1); }
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 36rpx; font-weight: bold; color: #9c27b0; display: block; }
.stat-label { font-size: 24rpx; color: #666; margin-top: 4rpx; display: block; }
.poster-section, .rules-section { margin: 0 30rpx 20rpx; padding: 24rpx; }
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 20rpx; display: block; }
.poster-preview { width: 100%; height: 400rpx; background: #f5f5f5; border-radius: 12rpx; overflow: hidden; margin-bottom: 20rpx; }
.poster-img { width: 100%; height: 100%; }
.poster-placeholder { width: 100%; height: 400rpx; background: #f5f5f5; border-radius: 12rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; margin-bottom: 20rpx; }
.poster-icon { font-size: 80rpx; margin-bottom: 12rpx; }
.poster-text { font-size: 26rpx; color: #999; }
.poster-actions { display: flex; gap: 20rpx; }
.generate-btn, .share-btn { flex: 1; padding: 20rpx; font-size: 28rpx; }
.rule-item { font-size: 26rpx; color: #666; line-height: 42rpx; display: block; margin-bottom: 12rpx; }
.login-btn { margin-top: 30rpx; width: 300rpx; }
