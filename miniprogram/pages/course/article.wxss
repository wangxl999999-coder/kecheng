.page-article {
  min-height: 100vh;
  background: #f5f5f5;
}

.article-header {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.article-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 50rpx;
  display: block;
  margin-bottom: 12rpx;
}

.article-meta {
  display: flex;
  gap: 20rpx;
}

.article-teacher, .article-update {
  font-size: 24rpx;
  color: #999;
}

.article-content {
  margin: 0 30rpx 20rpx;
  line-height: 48rpx;
  font-size: 30rpx;
}

.notes-section {
  margin: 0 30rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.notes-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: block;
}

.note-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.note-item:last-child {
  border-bottom: none;
}

.note-highlight {
  background: #fff9c4;
  padding: 8rpx 12rpx;
  border-radius: 4rpx;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  border-left: 4rpx solid #ffc107;
}

.note-content {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 4rpx;
}

.note-time {
  font-size: 22rpx;
  color: #999;
}

.chapter-list {
  padding: 0 30rpx;
}

.chapter-item {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.chapter-header {
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  font-weight: bold;
  border-bottom: 1rpx solid #f0f0f0;
}

.lesson-row {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f8f8f8;
}

.lesson-row.active {
  background: #fff8f5;
}

.lesson-row.active .lesson-name {
  color: #ff6b35;
}

.lesson-icon {
  margin-right: 12rpx;
}

.lesson-name {
  flex: 1;
  font-size: 28rpx;
}

.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.note-popup {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  width: 85%;
}

.note-popup-title {
  font-size: 30rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
  display: block;
}

.note-highlight-preview {
  background: #fff9c4;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  border-left: 4rpx solid #ffc107;
}

.highlight-text {
  font-size: 26rpx;
  color: #333;
}

.note-input {
  width: 100%;
  height: 200rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.note-actions {
  display: flex;
  gap: 20rpx;
}

.note-cancel {
  flex: 1;
  background: #f5f5f5;
  color: #666;
  border: none;
  border-radius: 44rpx;
  font-size: 28rpx;
  padding: 16rpx 0;
}

.note-cancel::after {
  border: none;
}

.note-save {
  flex: 1;
}
