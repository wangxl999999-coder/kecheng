.page-detail {
  padding-bottom: 140rpx;
  background: #f5f5f5;
}

.course-header {
  position: relative;
}

.course-cover {
  width: 100%;
  height: 420rpx;
}

.course-type-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
}

.course-base {
  margin: 20rpx 30rpx;
}

.course-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 50rpx;
}

.course-tags-row {
  display: flex;
  margin-top: 12rpx;
}

.price-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.current-price {
  color: #ff6b35;
  font-size: 40rpx;
  font-weight: bold;
  margin-right: 12rpx;
}

.buy-count {
  font-size: 24rpx;
  color: #999;
  margin-left: auto;
}

.group-price-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #fff1ec;
  border-radius: 8rpx;
}

.group-label {
  font-size: 24rpx;
  color: #ff6b35;
  margin-right: 12rpx;
}

.group-price {
  font-size: 32rpx;
  color: #ff6b35;
  font-weight: bold;
}

.teacher-card {
  display: flex;
  align-items: center;
  margin: 0 30rpx 20rpx;
  padding: 24rpx;
}

.teacher-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.teacher-info {
  flex: 1;
}

.teacher-name {
  font-size: 30rpx;
  font-weight: bold;
}

.teacher-title {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.teacher-fans {
  font-size: 24rpx;
  color: #999;
}

.live-countdown {
  margin: 0 30rpx 20rpx;
  text-align: center;
  padding: 30rpx;
}

.countdown-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.countdown-time {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 20rpx;
}

.countdown-num {
  background: #ff6b35;
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 36rpx;
  font-weight: bold;
  min-width: 60rpx;
  text-align: center;
}

.countdown-sep {
  margin: 0 8rpx;
  font-size: 36rpx;
  color: #ff6b35;
  font-weight: bold;
}

.reserve-btn {
  width: 300rpx;
  margin: 0 auto;
}

.detail-tabs {
  display: flex;
  background: #fff;
  margin: 0 30rpx;
  border-radius: 16rpx 16rpx 0 0;
  overflow: hidden;
}

.detail-tabs .tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.detail-tabs .tab-item.active {
  color: #ff6b35;
  font-weight: bold;
}

.detail-tabs .tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #ff6b35;
  border-radius: 3rpx;
}

.tab-content {
  padding: 0 30rpx 40rpx;
}

.intro-card {
  margin-top: 0;
  border-radius: 0 0 16rpx 16rpx;
}

.intro-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 44rpx;
  margin-bottom: 16rpx;
}

.intro-detail {
  font-size: 28rpx;
  line-height: 44rpx;
}

.chapter-list {
  padding: 10rpx 0;
}

.chapter-item {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.chapter-title {
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: bold;
  border-bottom: 1rpx solid #f0f0f0;
}

.lesson-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f8f8f8;
}

.lesson-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.lesson-type-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.lesson-title {
  font-size: 28rpx;
  color: #333;
}

.lesson-meta {
  display: flex;
  align-items: center;
}

.lesson-duration {
  font-size: 24rpx;
  color: #999;
  margin-right: 16rpx;
}

.lesson-free {
  font-size: 22rpx;
  color: #ff6b35;
  padding: 2rpx 12rpx;
  border: 1rpx solid #ff6b35;
  border-radius: 4rpx;
}

.review-list {
  padding: 10rpx 0;
}

.review-item {
  margin-bottom: 20rpx;
}

.review-header {
  margin-bottom: 12rpx;
}

.review-name {
  font-size: 28rpx;
  font-weight: bold;
}

.review-stars {
  font-size: 22rpx;
}

.review-content {
  font-size: 28rpx;
  color: #333;
  line-height: 42rpx;
}

.review-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.bar-left {
  display: flex;
  margin-right: 20rpx;
}

.bar-icon-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 30rpx;
}

.bar-icon {
  font-size: 36rpx;
}

.bar-icon-text {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.bar-right {
  display: flex;
  flex: 1;
}

.btn-group {
  background: linear-gradient(135deg, #2196f3, #42a5f5);
  color: #fff;
  border: none;
  border-radius: 44rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  margin-right: 12rpx;
  white-space: nowrap;
}

.btn-group::after {
  border: none;
}

.buy-btn {
  flex: 1;
  font-size: 26rpx;
  padding: 16rpx 24rpx;
  white-space: nowrap;
}

.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.popup-content {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 30rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.popup-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}

.buy-options {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.buy-option {
  flex: 1;
  padding: 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  text-align: center;
}

.buy-option.active {
  border-color: #ff6b35;
  background: #fff8f5;
}

.buy-option-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.buy-option-price {
  display: block;
  font-size: 36rpx;
  color: #ff6b35;
  font-weight: bold;
}

.buy-option-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.confirm-btn {
  width: 100%;
}
