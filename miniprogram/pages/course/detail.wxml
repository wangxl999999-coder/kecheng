<view class="page-detail" wx:if="{{course}}">
  <!-- 课程封面 -->
  <view class="course-header">
    <image class="course-cover" src="{{course.cover}}" mode="aspectFill" />
    <view class="course-type-badge tag tag-{{course.categoryType}}">
      {{course.categoryType === 'video' ? '视频课' : course.categoryType === 'audio' ? '音频课' : course.categoryType === 'article' ? '图文专栏' : course.categoryType === 'live' ? '直播课' : '训练营'}}
    </view>
  </view>

  <!-- 课程基本信息 -->
  <view class="course-base card">
    <text class="course-title">{{course.title}}</text>
    <view class="course-tags-row">
      <text class="tag tag-hot" wx:if="{{course.isHot}}">爆款</text>
      <text class="tag tag-new" wx:if="{{course.isNew}}">新课</text>
      <text class="tag tag-seckill" wx:if="{{course.isSeckill}}">秒杀</text>
      <text class="tag tag-group" wx:if="{{course.isGroup}}">拼团</text>
    </view>
    <view class="price-row">
      <text class="current-price">¥{{course.price}}</text>
      <text class="original-price">¥{{course.originalPrice}}</text>
      <text class="buy-count">{{course.buyCount}}人已购</text>
    </view>
    <view class="group-price-row" wx:if="{{course.isGroup}}">
      <text class="group-label">拼团价</text>
      <text class="group-price">¥{{course.groupPrice}}</text>
    </view>
  </view>

  <!-- 讲师信息 -->
  <view class="teacher-card card" bindtap="onCourseTap" data-id="{{course.teacher.id}}" wx:if="{{course.teacher}}">
    <image class="teacher-avatar" src="{{course.teacher.avatar}}" mode="aspectFill" />
    <view class="teacher-info">
      <text class="teacher-name">{{course.teacher.name}}</text>
      <text class="teacher-title">{{course.teacher.title}}</text>
    </view>
    <text class="teacher-fans">{{course.teacher.fans}}粉丝</text>
  </view>

  <!-- 直播倒计时 -->
  <view class="live-countdown card" wx:if="{{course.categoryType === 'live' && course.liveInfo.status === 'upcoming'}}">
    <text class="countdown-label">距离开播</text>
    <view class="countdown-time">
      <text class="countdown-num">{{countdown.hours}}</text>
      <text class="countdown-sep">:</text>
      <text class="countdown-num">{{countdown.minutes}}</text>
      <text class="countdown-sep">:</text>
      <text class="countdown-num">{{countdown.seconds}}</text>
    </view>
    <button class="btn-primary reserve-btn" bindtap="onLiveReserve">预约提醒</button>
  </view>

  <!-- Tab切换 -->
  <view class="detail-tabs">
    <view class="tab-item {{currentTab === 0 ? 'active' : ''}}" bindtap="onTabChange" data-index="0">课程介绍</view>
    <view class="tab-item {{currentTab === 1 ? 'active' : ''}}" bindtap="onTabChange" data-index="1">目录</view>
    <view class="tab-item {{currentTab === 2 ? 'active' : ''}}" bindtap="onTabChange" data-index="2">学员评价</view>
  </view>

  <!-- 课程介绍 -->
  <view class="tab-content" wx:if="{{currentTab === 0}}">
    <view class="intro-card card">
      <text class="intro-desc">{{course.description}}</text>
      <rich-text class="intro-detail" nodes="{{course.detail}}"></rich-text>
    </view>
  </view>

  <!-- 课程目录 -->
  <view class="tab-content" wx:if="{{currentTab === 1}}">
    <view class="chapter-list">
      <view class="chapter-item" wx:for="{{course.chapters}}" wx:key="id" wx:for-item="chapter" wx:for-index="chapterIndex">
        <view class="chapter-title">第{{chapterIndex + 1}}章 {{chapter.title}}</view>
        <view class="lesson-item" wx:for="{{chapter.lessons}}" wx:key="id" wx:for-item="lesson" wx:for-index="lessonIndex" bindtap="onLessonTap" data-chapter-index="{{chapterIndex}}" data-lesson-index="{{lessonIndex}}">
          <view class="lesson-info">
            <text class="lesson-type-icon">{{lesson.type === 'video' ? '🎬' : lesson.type === 'audio' ? '🎵' : lesson.type === 'article' ? '📖' : '📡'}}</text>
            <text class="lesson-title">{{lesson.title}}</text>
          </view>
          <view class="lesson-meta">
            <text class="lesson-duration" wx:if="{{lesson.duration}}">{{lesson.duration}}</text>
            <text class="lesson-free" wx:if="{{lesson.free}}">免费</text>
            <text class="lesson-lock" wx:else>🔒</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 学员评价 -->
  <view class="tab-content" wx:if="{{currentTab === 2}}">
    <view class="review-list">
      <view class="review-item card" wx:for="{{course.reviews}}" wx:key="id">
        <view class="review-header flex-between">
          <view class="review-user">
            <text class="review-name">{{item.userName}}</text>
          </view>
          <view class="review-stars">
            <text wx:for="{{5}}" wx:for-item="star" wx:key="*this">{{star < item.rating ? '⭐' : '☆'}}</text>
          </view>
        </view>
        <text class="review-content">{{item.content}}</text>
        <text class="review-time">{{item.time}}</text>
      </view>
    </view>
    <view class="empty-state" wx:if="{{course.reviews.length === 0}}">
      <text class="empty-icon">💬</text>
      <text>暂无评价</text>
    </view>
  </view>

  <!-- 底部购买栏 -->
  <view class="bottom-bar">
    <view class="bar-left">
      <view class="bar-icon-wrap" bindtap="onFavoriteTap">
        <text class="bar-icon">{{favorited ? '❤️' : '🤍'}}</text>
        <text class="bar-icon-text">收藏</text>
      </view>
      <view class="bar-icon-wrap" bindtap="onServiceTap">
        <text class="bar-icon">💬</text>
        <text class="bar-icon-text">客服</text>
      </view>
    </view>
    <view class="bar-right">
      <button class="btn-group" wx:if="{{course.isGroup}}" bindtap="onGroupBuyTap">¥{{course.groupPrice}} 拼团购买</button>
      <button class="btn-primary buy-btn" bindtap="onBuyTap">¥{{course.price}} 单独购买</button>
    </view>
  </view>

  <!-- 购买弹窗 -->
  <view class="popup-mask" wx:if="{{showBuyPopup}}" bindtap="onPopupClose">
    <view class="popup-content" catchtap="">
      <view class="popup-title">选择购买方式</view>
      <view class="buy-options">
        <view class="buy-option {{buyType === 'single' ? 'active' : ''}}" bindtap="onBuyTypeChange" data-type="single">
          <text class="buy-option-title">单独购买</text>
          <text class="buy-option-price">¥{{course.price}}</text>
        </view>
        <view class="buy-option {{buyType === 'group' ? 'active' : ''}}" bindtap="onBuyTypeChange" data-type="group" wx:if="{{course.isGroup}}">
          <text class="buy-option-title">拼团购买</text>
          <text class="buy-option-price">¥{{course.groupPrice}}</text>
          <text class="buy-option-desc">{{course.groupPrice}}元/人</text>
        </view>
      </view>
      <button class="btn-primary confirm-btn" bindtap="onConfirmBuy">确认购买</button>
    </view>
  </view>
</view>
