.page-audio {
  min-height: 100vh;
  background: #f5f5f5;
}

.audio-player {
  background: linear-gradient(135deg, #2c3e50, #3498db);
  padding: 60rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.audio-cover {
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 255, 255, 0.3);
  margin-bottom: 30rpx;
}

.audio-title {
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.audio-teacher {
  color: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
  margin-bottom: 30rpx;
}

.audio-progress {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 30rpx;
}

.audio-progress .time {
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  min-width: 60rpx;
}

.audio-progress .slider {
  flex: 1;
  margin: 0 16rpx;
}

.audio-controls {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.ctrl-btn {
  font-size: 48rpx;
  padding: 16rpx;
  color: #fff;
}

.ctrl-play {
  font-size: 80rpx;
  padding: 16rpx 40rpx;
  color: #fff;
  margin: 0 30rpx;
}

.audio-tools {
  display: flex;
  gap: 40rpx;
}

.tool-item {
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
}

.chapter-list {
  padding: 20rpx 30rpx;
}

.chapter-item {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.chapter-header {
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  font-weight: bold;
  border-bottom: 1rpx solid #f0f0f0;
}

.lesson-row {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f8f8f8;
}

.lesson-row.active {
  background: #fff8f5;
}

.lesson-row.active .lesson-name {
  color: #ff6b35;
}

.lesson-icon {
  margin-right: 12rpx;
}

.lesson-name {
  flex: 1;
  font-size: 28rpx;
}

.lesson-dur {
  font-size: 24rpx;
  color: #999;
}

.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.timer-popup {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  width: 70%;
}

.timer-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: block;
}

.timer-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.timer-item {
  padding: 16rpx;
  text-align: center;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.timer-item.active {
  border-color: #ff6b35;
  color: #ff6b35;
  background: #fff8f5;
}
