<view class="page-search">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索课程名称、讲师" value="{{keyword}}" bindinput="onInput" bindconfirm="onSearch" confirm-type="search" focus="{{true}}" />
      <text class="clear-icon" wx:if="{{keyword}}" bindtap="onClearInput">✕</text>
    </view>
    <text class="search-btn" bindtap="onSearch">搜索</text>
  </view>

  <!-- 搜索历史 -->
  <view class="history-section" wx:if="{{!searched && searchHistory.length > 0}}">
    <view class="section-header flex-between">
      <text class="section-title">搜索历史</text>
      <text class="delete-btn" bindtap="onHistoryDelete">🗑️</text>
    </view>
    <view class="history-tags">
      <text class="history-tag" wx:for="{{searchHistory}}" wx:key="*this" bindtap="onKeywordTap" data-keyword="{{item}}">{{item}}</text>
    </view>
  </view>

  <!-- 热门搜索 -->
  <view class="hot-section" wx:if="{{!searched}}">
    <text class="section-title">🔥 热门搜索</text>
    <view class="hot-tags">
      <text class="hot-tag" wx:for="{{hotKeywords}}" wx:key="*this" bindtap="onKeywordTap" data-keyword="{{item}}">{{item}}</text>
    </view>
  </view>

  <!-- 搜索结果 -->
  <view class="result-section" wx:if="{{searched}}">
    <view class="result-list">
      <view class="course-card card" wx:for="{{searchResult}}" wx:key="id" bindtap="onCourseTap" data-id="{{item.id}}">
        <image class="course-cover" src="{{item.cover}}" mode="aspectFill" />
        <view class="course-info">
          <text class="course-title text-ellipsis-2">{{item.title}}</text>
          <text class="course-teacher">{{item.teacherName}}</text>
          <view class="course-tags">
            <text class="tag tag-{{item.categoryType}}">{{item.categoryType === 'video' ? '视频课' : item.categoryType === 'audio' ? '音频课' : item.categoryType === 'article' ? '图文专栏' : item.categoryType === 'live' ? '直播课' : '训练营'}}</text>
          </view>
          <view class="course-meta">
            <text class="price">{{item.price}}</text>
            <text class="original-price">{{item.originalPrice}}</text>
            <text class="buy-count">{{item.buyCount}}人已购</text>
          </view>
        </view>
      </view>
    </view>
    <view class="empty-state" wx:if="{{searchResult.length === 0 && !searching}}">
      <text class="empty-icon">🔍</text>
      <text>未找到相关课程</text>
    </view>
    <view class="loading-wrap" wx:if="{{searching}}">
      <text>搜索中...</text>
    </view>
  </view>
</view>
