.page-category {
  min-height: 100vh;
  background: #f5f5f5;
}

.category-tabs {
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tabs-inner {
  display: flex;
  padding: 0 20rpx;
  white-space: nowrap;
}

.tab-item {
  display: inline-block;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #ff6b35;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #ff6b35;
  border-radius: 3rpx;
}

.course-list {
  padding: 20rpx 30rpx;
}

.course-card {
  display: flex;
  flex-direction: row;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.course-cover {
  width: 240rpx;
  height: 170rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.course-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.course-title {
  font-size: 28rpx;
  font-weight: bold;
  line-height: 40rpx;
}

.course-teacher {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.course-tags {
  display: flex;
  margin-top: 8rpx;
}

.course-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.buy-count {
  font-size: 22rpx;
  color: #999;
  margin-left: auto;
}
