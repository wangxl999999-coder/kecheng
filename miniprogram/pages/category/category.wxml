<view class="page-category">
  <!-- 分类Tab -->
  <view class="category-tabs">
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}">
      <view class="tabs-inner">
        <view class="tab-item {{currentTab === index ? 'active' : ''}}" wx:for="{{categories}}" wx:key="id" bindtap="onTabTap" data-index="{{index}}">
          <text>{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 课程列表 -->
  <view class="course-list">
    <view class="course-card card" wx:for="{{courses}}" wx:key="id" bindtap="onCourseTap" data-id="{{item.id}}">
      <image class="course-cover" src="{{item.cover}}" mode="aspectFill" />
      <view class="course-info">
        <text class="course-title text-ellipsis-2">{{item.title}}</text>
        <text class="course-teacher">{{item.teacherName}}</text>
        <view class="course-tags">
          <text class="tag tag-hot" wx:if="{{item.isHot}}">爆款</text>
          <text class="tag tag-new" wx:if="{{item.isNew}}">新课</text>
          <text class="tag tag-group" wx:if="{{item.isGroup}}">拼团</text>
        </view>
        <view class="course-meta">
          <text class="price">{{item.price}}</text>
          <text class="original-price">{{item.originalPrice}}</text>
          <text class="buy-count">{{item.buyCount}}人已购</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{courses.length === 0 && !loading}}">
    <text class="empty-icon">📚</text>
    <text>暂无该分类课程</text>
  </view>

  <view class="loading-wrap" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
